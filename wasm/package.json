{
  "name": "@mik1810/nxpp-wasm",
  "version": "0.6.0",
  "description": "Experimental Node.js WASM bindings for nxpp",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/types.d.ts",
    "dist/algorithms/centrality.js",
    "dist/algorithms/centrality.d.ts",
    "dist/algorithms/components.js",
    "dist/algorithms/components.d.ts",
    "dist/algorithms/shortest_paths.js",
    "dist/algorithms/shortest_paths.d.ts",
    "dist/core/graph.js",
    "dist/core/graph.d.ts",
    "dist/core/multigraph.js",
    "dist/core/multigraph.d.ts",
    "dist/internal/assert.js",
    "dist/internal/assert.d.ts",
    "dist/internal/errors.js",
    "dist/internal/errors.d.ts",
    "dist/internal/wasm_types.d.ts",
    "dist/internal/wrap.js",
    "dist/internal/wrap.d.ts",
    "dist/runtime/context.js",
    "dist/runtime/context.d.ts",
    "dist/runtime/node.js",
    "dist/runtime/node.d.ts",
    "runtime/node.mjs",
    "runtime/node.wasm",
    "README.md"
  ],
  "keywords": [
    "graph",
    "wasm",
    "emscripten",
    "nxpp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.json",
    "bench:overhead": "bash scripts/run_overhead_benchmarks.sh",
    "check:raw-contract": "node scripts/check_wasm_raw_contract.mjs",
    "check:node-contract": "bash scripts/run_wasm_node_contract_tests.sh",
    "check:npm-pack-consumer": "bash scripts/run_npm_pack_consumer_test.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mik1810/nxpp.git"
  },
  "homepage": "https://github.com/Mik1810/nxpp",
  "bugs": {
    "url": "https://github.com/Mik1810/nxpp/issues"
  }
}
